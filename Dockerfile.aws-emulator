FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal

# Install AWS Emulator
ADD https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS/latest/aws-emulator-x86_64.rpm /tmp/aws-emulator.rpm
RUN rpm -i /tmp/aws-emulator.rpm && rm /tmp/aws-emulator.rpm

# AWS Emulator may try to use /home/emulator or /root for data storage
# Pre-create directories so AWS Emulator can write to them
RUN mkdir -p /home/emulator/.aws/emulator /home/emulator/.emulator /root/.aws/emulator /root/.emulator \
    && chmod -R 777 /home/emulator /root/.aws /root/.emulator \
    && mkdir -p /.emulator /.aws-emulator \
    && chmod -R 777 /.emulator /.aws-emulator /tmp

# Create a startup script line by line to avoid heredoc parsing issues
RUN echo '#!/bin/sh' > /usr/local/bin/start-emulator.sh && \
    echo 'set -e' >> /usr/local/bin/start-emulator.sh && \
    echo '' >> /usr/local/bin/start-emulator.sh && \
    echo '# Start AWS Emulator in background' >> /usr/local/bin/start-emulator.sh && \
    echo 'aws-emulator -b 0.0.0.0 &' >> /usr/local/bin/start-emulator.sh && \
    echo 'EMULATOR_PID=$!' >> /usr/local/bin/start-emulator.sh && \
    echo '' >> /usr/local/bin/start-emulator.sh && \
    echo '# Wait for credentials to be generated (up to 10 seconds)' >> /usr/local/bin/start-emulator.sh && \
    echo 'for i in $(seq 1 20); do' >> /usr/local/bin/start-emulator.sh && \
    echo '    if [ -f /home/emulator/.aws/emulator/9297/emulator_credentials ]; then' >> /usr/local/bin/start-emulator.sh && \
    echo '        echo "✅ Credentials file created"' >> /usr/local/bin/start-emulator.sh && \
    echo '        break' >> /usr/local/bin/start-emulator.sh && \
    echo '    fi' >> /usr/local/bin/start-emulator.sh && \
    echo '    sleep 0.5' >> /usr/local/bin/start-emulator.sh && \
    echo 'done' >> /usr/local/bin/start-emulator.sh && \
    echo '' >> /usr/local/bin/start-emulator.sh && \
    echo '# Make all generated files world-readable so host can copy them' >> /usr/local/bin/start-emulator.sh && \
    echo 'chmod -R 755 /home/emulator/.aws/emulator/9297/' >> /usr/local/bin/start-emulator.sh && \
    echo 'echo "✅ Fixed permissions on credentials directory"' >> /usr/local/bin/start-emulator.sh && \
    echo '' >> /usr/local/bin/start-emulator.sh && \
    echo '# Wait for the emulator process (this keeps the container running)' >> /usr/local/bin/start-emulator.sh && \
    echo 'wait $EMULATOR_PID' >> /usr/local/bin/start-emulator.sh && \
    chmod +x /usr/local/bin/start-emulator.sh

EXPOSE 9297

# Run startup script
ENTRYPOINT ["/usr/local/bin/start-emulator.sh"]

