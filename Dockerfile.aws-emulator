FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal

# Install AWS Emulator
ADD https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS/latest/aws-emulator-x86_64.rpm /tmp/aws-emulator.rpm
RUN rpm -i /tmp/aws-emulator.rpm && rm /tmp/aws-emulator.rpm

# Create emulator directories with world-writable permissions
# AWS Emulator needs to write to its data directories
RUN mkdir -p /home/emulator/.aws/emulator /home/emulator/.emulator \
    && chmod -R 777 /home/emulator \
    && mkdir -p /.emulator /.aws-emulator \
    && chmod -R 777 /.emulator /.aws-emulator /tmp

ENV HOME=/home/emulator
EXPOSE 9297

# Bind to localhost instead of 0.0.0.0 (Docker handles port mapping)
# This avoids permission issues with binding to privileged ports
ENTRYPOINT ["aws-emulator", "-b", "127.0.0.1"]
