FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal

# Install AWS Emulator
ADD https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS/latest/aws-emulator-x86_64.rpm /tmp/aws-emulator.rpm
RUN rpm -i /tmp/aws-emulator.rpm && rm /tmp/aws-emulator.rpm

# AWS Emulator may try to use /home/emulator or /root for data storage
# Pre-create directories so AWS Emulator can write to them
RUN mkdir -p /home/emulator/.aws/emulator /home/emulator/.emulator /root/.aws/emulator /root/.emulator \
    && chmod -R 777 /home/emulator /root/.aws /root/.emulator \
    && mkdir -p /.emulator /.aws-emulator \
    && chmod -R 777 /.emulator /.aws-emulator /tmp

# Create a startup script using printf and shell
RUN printf '#!/bin/sh\nset -e\n\n# Start AWS Emulator in background\naws-emulator -b 0.0.0.0 &\nEMULATOR_PID=$!\n\n# Wait for credentials to be generated (up to 10 seconds)\nfor i in $(seq 1 20); do\n    if [ -f /home/emulator/.aws/emulator/9297/emulator_credentials ]; then\n        echo "✅ Credentials file created"\n        break\n    fi\n    sleep 0.5\ndone\n\n# Make all generated files world-readable so host can copy them\nchmod -R 755 /home/emulator/.aws/emulator/9297/\necho "✅ Fixed permissions on credentials directory"\n\n# Wait for the emulator process (this keeps the container running)\nwait $EMULATOR_PID\n' > /usr/local/bin/start-emulator.sh && chmod +x /usr/local/bin/start-emulator.sh

EXPOSE 9297

# Run startup script
ENTRYPOINT ["/usr/local/bin/start-emulator.sh"]

