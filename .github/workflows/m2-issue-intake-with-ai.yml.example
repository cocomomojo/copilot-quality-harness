#!/bin/bash
# m2-issue-intake-with-ai-judgment.yml
# M2 ワークフロー + Copilot Skill 統合例

name: M2 Issue Intake (with AI Auto-Judgment)

on:
  workflow_dispatch:
    inputs:
      issue_number:
        description: Open issue number in this repository
        required: true
        type: string
      use_ai_judgment:
        description: Use Copilot AI for judgment (requires copilot CLI)
        required: false
        type: boolean
        default: true

permissions:
  contents: read
  issues: write

jobs:
  intake-and-judge:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      
      # 既存: M2 分析実行
      - name: Validate dispatch input
        id: input
        env:
          ISSUE_NUMBER: ${{ inputs.issue_number }}
        run: |
          node --input-type=module -e '
            import { validateDispatchIssueNumber } from "./scripts/m2-validation.mjs";
            const result = validateDispatchIssueNumber(process.env.ISSUE_NUMBER);
            if (!result.valid) {
              console.error(result.error);
              process.exit(2);
            }
            process.stdout.write(`issue_number=${result.issueNumber}\n`);
          ' >> "$GITHUB_OUTPUT"
      
      - name: Fetch trusted same-repository issue
        env:
          GH_TOKEN: ${{ github.token }}
          ISSUE_NUMBER: ${{ steps.input.outputs.issue_number }}
        run: gh api "repos/${GITHUB_REPOSITORY}/issues/${ISSUE_NUMBER}" > "$RUNNER_TEMP/m2-issue.json"
      
      - name: Run M2 analysis
        id: analyze
        env:
          ISSUE_NUMBER: ${{ steps.input.outputs.issue_number }}
          OUTPUT_FILE: ${{ runner.temp }}/m2-report.json
        run: |
          set +e
          node scripts/m2-validation.mjs \
            --github-issue "$RUNNER_TEMP/m2-issue.json" \
            --issue-number "$ISSUE_NUMBER" \
            --repository "$GITHUB_REPOSITORY" \
            --catalog qa/test-management/test-observation-catalog.yml \
            --root . \
            --output "$OUTPUT_FILE"
          result=$?
          echo "validation_exit_code=$result" >> "$GITHUB_OUTPUT"
          if [ "$result" -eq 4 ]; then exit 4; fi
          exit 0
      
      # 新規: Copilot AI による判定（オプション）
      - name: Setup Copilot CLI for AI Judgment
        if: inputs.use_ai_judgment == true && steps.analyze.outcome == 'success'
        run: |
          npm install -g @copilot/cli
          echo "✅ Copilot CLI installed"
      
      - name: Run AI judgment with Copilot Skill
        if: inputs.use_ai_judgment == true && steps.analyze.outcome == 'success'
        id: ai-judgment
        env:
          REPORT_FILE: ${{ runner.temp }}/m2-report.json
        run: |
          set +e
          
          # Copilot Skill で AI 判定を実行
          copilot review --skill "m2-auto-judgment" \
            --input "$REPORT_FILE" \
            --format json \
            --output /tmp/ai-judgment.json 2>&1 || {
            echo "⚠️ Copilot AI judgment failed, falling back to rule-based judgment"
            # フォールバック: ルールベース判定
            node scripts/m2-auto-judgment.mjs \
              --report "$REPORT_FILE" \
              --threshold moderate \
              --format json > /tmp/ai-judgment.json
          }
          
          # 結果をパース
          if [ -f /tmp/ai-judgment.json ]; then
            LEVEL=$(jq -r '.level' /tmp/ai-judgment.json)
            REASON=$(jq -r '.reason' /tmp/ai-judgment.json)
            
            echo "JUDGMENT_LEVEL=$LEVEL" >> "$GITHUB_OUTPUT"
            echo "JUDGMENT_REASON=$REASON" >> "$GITHUB_OUTPUT"
            echo "✅ Judgment result: $LEVEL"
          else
            echo "❌ Judgment failed"
            exit 1
          fi
      
      # 既存: Markdown 変換 + Issue コメント
      - name: Format M2 report as Markdown
        if: steps.analyze.outcome == 'success'
        id: format-report
        env:
          REPORT_FILE: ${{ runner.temp }}/m2-report.json
          MARKDOWN_FILE: ${{ runner.temp }}/m2-report.md
        run: |
          node scripts/format-m2-report.mjs \
            --input "$REPORT_FILE" \
            --output "$MARKDOWN_FILE"
          echo "markdown_file=$MARKDOWN_FILE" >> "$GITHUB_OUTPUT"
      
      - name: Comment with analysis and judgment result
        if: always() && steps.analyze.outcome != 'skipped'
        uses: actions/github-script@v7
        env:
          ISSUE_NUMBER: ${{ steps.input.outputs.issue_number }}
          REPORT_FILE: ${{ runner.temp }}/m2-report.json
          MARKDOWN_FILE: ${{ steps.format-report.outputs.markdown_file }}
          USE_AI: ${{ inputs.use_ai_judgment }}
          AI_LEVEL: ${{ steps.ai-judgment.outputs.JUDGMENT_LEVEL }}
          AI_REASON: ${{ steps.ai-judgment.outputs.JUDGMENT_REASON }}
        with:
          script: |
            const fs = require('node:fs');
            
            if (!fs.existsSync(process.env.REPORT_FILE)) {
              core.warning('No M2 report was produced');
              return;
            }
            
            const report = JSON.parse(fs.readFileSync(process.env.REPORT_FILE, 'utf8'));
            if (report.sourceTrust?.verified !== true) {
              core.warning('Issue source was not verified');
              return;
            }
            
            const lines = [
              `## M2 自動化ワークフロー分析結果`,
              ``,
              `Issue: #${report.sourceTrust.issueNumber}`,
              `ソース: \`${report.sourceTrust.repository}\` (検証済み)`,
              ``,
              `**AI判定**: ${process.env.USE_AI === 'true' ? '✅ Copilot Skill' : '⚠️ ルールベース'}`,
              process.env.USE_AI === 'true' ? `**判定結果**: ${process.env.AI_LEVEL}` : '',
              process.env.AI_REASON ? `**判定理由**: ${process.env.AI_REASON}` : '',
              ``,
            ].filter(Boolean);
            
            // AI判定結果に基づくアクション提示
            if (process.env.AI_LEVEL === 'safe-proceed') {
              lines.push(
                '✅ **自動実装可能**',
                '自動実装をトリガーします。'
              );
            } else if (process.env.AI_LEVEL === 'needs-approval') {
              lines.push(
                '⚠️ **条件付き実装**',
                `上記の理由を確認後、以下でコメントして実装を進行してください：`,
                '```',
                '/auto-implement',
                '```'
              );
            } else if (process.env.AI_LEVEL === 'manual-only') {
              lines.push(
                '❌ **手動判断必須**',
                `上記の理由に基づき、手動での実装判断が必須です。`
              );
            }
            
            lines.push('', '---', '');
            
            // Markdown レポートを追加
            if (fs.existsSync(process.env.MARKDOWN_FILE)) {
              const markdown = fs.readFileSync(process.env.MARKDOWN_FILE, 'utf8');
              lines.push(markdown);
            }
            
            lines.push('', `レポート: [M2 実行結果](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId})`);
            
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: Number(process.env.ISSUE_NUMBER),
              body: lines.join('\n')
            });
      
      - name: Trigger auto-implementation if safe-proceed
        if: steps.ai-judgment.outputs.JUDGMENT_LEVEL == 'safe-proceed'
        env:
          GH_TOKEN: ${{ github.token }}
          ISSUE_NUMBER: ${{ steps.input.outputs.issue_number }}
        run: |
          echo "🚀 Triggering spec-to-implementation workflow..."
          gh workflow run spec-to-implementation.yml \
            -f issue_number="$ISSUE_NUMBER" \
            -f auto_judgment="true"
      
      - name: Upload M2 report artifact
        if: always() && steps.analyze.outcome != 'skipped'
        uses: actions/upload-artifact@v4
        with:
          name: m2-issue-${{ steps.input.outputs.issue_number }}-run-${{ github.run_id }}
          path: ${{ runner.temp }}/m2-report.json
          if-no-files-found: warn
          retention-days: 14
